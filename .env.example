# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (db container; Compose also builds the backend's DATABASE_URL from these)
POSTGRES_USER=geomeasure
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geomeasure
POSTGRES_PORT=5432

# --- Frontend (nginx serves the app and proxies /api to the backend)
FRONTEND_PORT=5173

# --- Backend
APP_NAME=GeoMeasure
APP_ENV=development
BACKEND_PORT=8000

# Used when running the backend directly on your machine (outside Docker).
# Inside Compose this is replaced with the in-network host: ...@db:5432/geomeasure
DATABASE_URL=postgresql+psycopg://geomeasure:change-me@localhost:5432/geomeasure
TEST_DATABASE_URL=postgresql+psycopg://geomeasure:change-me@localhost:5432/geomeasure_test

STORAGE_DIR=../storage
MAX_UPLOAD_SIZE_MB=50
MAX_EXTRACTED_SIZE_MB=500
# Upper bound on features returned by GET /api/files/{id}/geojson
GEOJSON_PREVIEW_MAX_FEATURES=5000
ALLOWED_EXTENSIONS=.kml,.zip
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# json (Docker / log shipping) or text (readable local terminal output)
LOG_FORMAT=json

# Host UID/GID for the backend container user, so ./storage stays writable.
APP_UID=1000
APP_GID=1000
